<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>They Published What?</title>
<style>
:root{color-scheme:light;--ink:#202630;--muted:#666e79;--line:#e4e7eb;--link:#164e91;--active:#173b64}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:#fff;color:var(--ink);font:16px/1.5 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}main{max-width:1120px;margin:auto;padding:40px 24px 30px}header{border-bottom:1px solid var(--line);padding-bottom:20px}h1{font:700 clamp(2.2rem,5vw,3.3rem)/1.1 Georgia,serif;letter-spacing:-.045em;margin:0 0 10px}header p{color:var(--muted);font-size:14px;margin:0}.categories{display:flex;flex-wrap:wrap;gap:7px;margin:22px 0}.group{font:inherit;font-size:13px;padding:7px 10px;border:1px solid var(--line);border-radius:5px;background:#fff;color:var(--ink);cursor:pointer;text-align:left}.group small{color:var(--muted);margin-left:4px;font-variant-numeric:tabular-nums}.group[aria-pressed=true]{background:var(--active);border-color:var(--active);color:white}.group[aria-pressed=true] small{color:#e3ebf4}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 24px}.filters input,.filters select{font:inherit;font-size:14px;padding:8px;border:1px solid #c8ced6;border-radius:4px;background:#fff;min-width:0;color:var(--ink)}.filters input{flex:1 1 230px}.filters select{flex:1 1 140px;max-width:250px}.section{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding-bottom:8px;border-bottom:2px solid #23364a}h2{font-size:20px;margin:0}#count{color:var(--muted);font-size:13px;white-space:nowrap}ul{padding:0;margin:0;list-style:none}.entry{display:grid;grid-template-columns:minmax(0,1fr) minmax(145px,28%);gap:24px;align-items:baseline;padding:11px 0;border-bottom:1px solid var(--line);scroll-margin-top:12px}.entry a{color:var(--link);text-decoration:none;font-weight:550;overflow-wrap:anywhere}.entry a:hover{text-decoration:underline}.entry a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid #1e6db4;outline-offset:3px}.venue{color:var(--muted);font-size:13px;overflow-wrap:anywhere}.empty{color:var(--muted);padding:20px 0}footer{font-size:12px;color:var(--muted);margin-top:35px;padding-top:16px;border-top:1px solid var(--line)}footer a{color:var(--link)}details{margin-top:8px}.downloads{display:flex;flex-wrap:wrap;gap:12px;margin-top:8px}@media(max-width:640px){main{padding:26px 16px}.entry{display:block;padding:10px 0}.venue{display:block;margin-top:2px}.filters select{max-width:none}.categories{gap:5px}.group{padding:6px 8px}.section h2{font-size:18px}}@media print{.categories,.filters,footer{display:none}.entry{break-inside:avoid}}
.study-result{margin:4px 0 0;color:var(--muted);font-size:14px}
</style></head><body><main>
<header><h1>They Published What?</h1><p>__TOTAL__ studies across __FIELDS__ categories. A collection of surprising research claims and studies that test whether findings hold up.</p></header>
<nav class="categories" aria-label="Categories">__BUTTONS__</nav>
<div class="filters"><input id="query" type="search" aria-label="Search papers" placeholder="Search titles or journals"><select id="sub" aria-label="Subfield"><option value="">All subfields</option></select><select id="topic" aria-label="Topic"><option value="">All topics</option></select></div>
<div class="section"><h2 id="view-title">Top 20</h2><span id="count" aria-live="polite"></span></div>
<ul id="list">__CARDS__</ul><p class="empty" hidden>No matching papers.</p>
</main><script>
const q=s=>document.querySelector(s),entries=[...document.querySelectorAll('.entry')],buttons=[...document.querySelectorAll('.group')],TOP='__top20__',EMPIRICAL_CRISIS='__EMPIRICAL_CRISIS_FIELD__';const sub=q('#sub'),topic=q('#topic'),query=q('#query');let field=TOP;const cached=new Map(entries.map(c=>[c,[c.textContent,c.dataset.title,c.dataset.sub,c.dataset.topic].join(' ').toLowerCase()]));
function options(el,label,values){const old=el.value;el.replaceChildren(new Option(label,''));for(const v of [...new Set(values)].sort((a,b)=>a.localeCompare(b)))el.add(new Option(v,v));if(values.includes(old))el.value=old;}
function update(){const branch=entries.filter(c=>!field||(field===TOP?+c.dataset.rank>0:c.dataset.field===field));options(sub,field===EMPIRICAL_CRISIS?'All disciplines':'All subfields',branch.map(c=>c.dataset.sub));const children=branch.filter(c=>!sub.value||c.dataset.sub===sub.value);options(topic,field===EMPIRICAL_CRISIS?'All study types':'All topics',children.map(c=>c.dataset.topic));const words=query.value.trim().toLowerCase().split(/\s+/).filter(Boolean);const result=children.filter(c=>(!topic.value||c.dataset.topic===topic.value)&&words.every(w=>cached.get(c).includes(w)));const set=new Set(result);for(const c of entries)c.hidden=!set.has(c);for(const b of buttons)b.setAttribute('aria-pressed',String(b.dataset.field===field));q('#view-title').textContent=field===TOP?'Top 20':field||'All fields';q('#count').textContent=result.length+' '+(result.length===1?'paper':'papers');q('.empty').hidden=!!result.length;}
function selectField(value){field=value;query.value=sub.value=topic.value='';update();}
for(const b of buttons)b.onclick=()=>selectField(b.dataset.field);
query.oninput=update;sub.onchange=()=>{topic.value='';update();};topic.onchange=update;function linked(){let c=document.getElementById(location.hash.slice(1));if(!c||!c.classList.contains('entry'))return;if(c.hidden)selectField(c.dataset.field);c.scrollIntoView();}window.addEventListener('hashchange',linked);update();linked();
</script></body></html>
